// ============ SIMPLE FACE DETECTION (ON-DEVICE) ============
// Uses cascade classifier - basic but works on ESP32S3
bool detectFace(camera_fb_t* frame) {
    // For MVP: Check frame brightness variance as proxy for face presence
    // In production, use: https://github.com/espressif/esp-face
    
    if (frame == NULL) return false;
    
    uint8_t* data = frame->buf;
    int len = frame->len;
    
    // Simple heuristic: JPEG has face data if size is within range
    // A face typically produces 15-40KB JPEG at VGA resolution
    return (len > 10000 && len < 100000);
}

// ============ CAPTURE MULTIPLE FRAMES ============
void captureMultipleFrames() {
    Serial.println("Starting multi-frame capture...");
    capturedCount = 0;
    lastCaptureTime = millis();
    
    // Warm up camera
    camera_fb_t* fb = esp_camera_fb_get();
    if (fb) esp_camera_fb_return(fb);
    delay(100);
    
    while (capturedCount < NUM_CAPTURES) {
        if (millis() - lastCaptureTime >= CAPTURE_INTERVAL_MS) {
            camera_fb_t* fb = esp_camera_fb_get();
            
            if (fb) {
                if (detectFace(fb)) {
                    frameBuffer[capturedCount] = fb;
                    capturedCount++;
                    Serial.printf("Captured frame %d/%d\n", capturedCount, NUM_CAPTURES);
                    lastCaptureTime = millis();
                } else {
                    esp_camera_fb_return(fb);
                }
            }
            
            delay(10);
        }
    }
    
    Serial.println("Multi-frame capture complete");
}

// ============ SEND TO BACKEND ============
void sendFramesToBackend() {
    if (capturedCount == 0) {
        Serial.println("No frames captured");
        return;
    }
    
    Serial.printf("Sending %d frames to backend...\n", capturedCount);
    
    HTTPClient http;
    String url = "http://" + String(BACKEND_SERVER) + ":" + String(BACKEND_PORT) + "/process";
    
    http.begin(url);
    http.addHeader("Content-Type", "application/octet-stream");
    
    // Calculate total size
    size_t totalSize = 0;
    for (int i = 0; i < capturedCount; i++) {
        totalSize += frameBuffer[i]->len + 4;  // +4 for size prefix
    }
    
    Serial.printf("Total payload: %d bytes\n", totalSize);
    
    // Prepare payload: format = [frame_size(4bytes)][frame_data]...[frame_size][frame_data]
    uint8_t* payload = (uint8_t*)malloc(totalSize);
    if (payload == NULL) {
        Serial.println("Memory allocation failed");
        cleanupFrames();
        return;
    }
    
    size_t pos = 0;
    for (int i = 0; i < capturedCount; i++) {
        uint32_t frameSize = frameBuffer[i]->len;
        memcpy(payload + pos, &frameSize, 4);
        pos += 4;
        memcpy(payload + pos, frameBuffer[i]->buf, frameSize);
        pos += frameSize;
    }
    
    // Send
    int httpResponseCode = http.POST(payload, totalSize);
    
    if (httpResponseCode == 200) {
        String response = http.getString();
        Serial.println("Success! Response:");
        Serial.println(response);
        
        // Parse response and download result if available
        // (Save to SPIFFS or display)
    } else {
        Serial.printf("HTTP Error: %d\n", httpResponseCode);
    }
    
    http.end();
    free(payload);
    cleanupFrames();
}

// ============ CLEANUP ============
void cleanupFrames() {
    for (int i = 0; i < capturedCount; i++) {
        if (frameBuffer[i] != NULL) {
            esp_camera_fb_return(frameBuffer[i]);
            frameBuffer[i] = NULL;
        }
    }
    capturedCount = 0;
}

// ============ SETUP ============
void setup() {
    Serial.begin(115200);
    delay(2000);
    
    Serial.println("\n\n=== Multi-Image Super-Resolution System ===\n");
    
    if (!initCamera()) {
        Serial.println("Camera init failed!");
        while (1);
    }
    
    if (!initWiFi()) {
        Serial.println("WiFi init failed!");
        while (1);
    }
    
    Serial.println("System ready. Press button to capture and process.");
}

// ============ MAIN LOOP ============
void loop() {
    // Trigger on button press (GPIO38 on XIAO ESP32S3 Sense)
    if (digitalRead(38) == LOW) {
        delay(50);  // Debounce
        if (digitalRead(38) == LOW) {
            Serial.println("\n>>> Button pressed - Starting capture sequence\n");
            captureMultipleFrames();
            delay(1000);
            sendFramesToBackend();
            while (digitalRead(38) == LOW) delay(10);
            delay(500);
        }
    }
    
    delay(100);
}
