from flask import Flask, request, jsonify, send_file
import cv2
import numpy as np
import io
import struct
from datetime import datetime
import os

from utils.image_processor import ImageProcessor
from utils.face_detector import FaceDetector
from utils.super_resolver import SuperResolver

app = Flask(__name__)

# Initialize components
face_detector = FaceDetector()
image_processor = ImageProcessor()
super_resolver = SuperResolver(scale=4)

@app.route('/health', methods=['GET'])
def health():
    """Health check endpoint"""
    return jsonify({'status': 'ok', 'service': 'Multi-Image Super-Resolution'}), 200

@app.route('/process', methods=['POST'])
def process_images():
    """
    Process multiple images from ESP32S3
    
    Expected format:
    [frame_size(4bytes)][frame_data]...[frame_size][frame_data]
    """
    try:
        print(f"\n{'='*60}")
        print(f"Processing request received at {datetime.now()}")
        print(f"Payload size: {len(request.data)} bytes")
        
        # Parse frames
        frames = []
        pos = 0
        data = request.data
        
        while pos < len(data):
            if pos + 4 > len(data):
                break
            
            frame_size = struct.unpack('<I', data[pos:pos+4])[0]
            pos += 4
            
            if pos + frame_size > len(data):
                break
            
            frame_data = data[pos:pos+frame_size]
            pos += frame_size
            
            # Decode JPEG
            img_array = np.frombuffer(frame_data, dtype=np.uint8)
            img = cv2.imdecode(img_array, cv2.IMREAD_COLOR)
            
            if img is not None:
                frames.append(img)
                print(f"  Frame {len(frames)}: {img.shape}")
        
        print(f"Total frames parsed: {len(frames)}")
        
        if len(frames) == 0:
            return jsonify({'error': 'No valid frames received'}), 400
        
        # ========== PROCESSING PIPELINE ==========
        
        # Step 1: Detect faces
        print("\n[1/5] Detecting faces...")
        faces = face_detector.detect_faces(frames[0])
        
        if not faces:
            print("  No faces detected!")
            largest_face = None
        else:
            largest_face = image_processor.ImageProcessor.get_largest_face(faces)
            print(f"  Detected {len(faces)} face(s)")
            print(f"  Largest face: {largest_face}")
        
        # Step 2: Align images
        print("\n[2/5] Aligning images...")
        aligned_frames = image_processor.align_images(frames)
        print(f"  Aligned {len(aligned_frames)} frames")
        
        # Step 3: Fuse images
        print("\n[3/5] Fusing images...")
        fused = image_processor.fuse_images(aligned_frames)
        print(f"  Fused image shape: {fused.shape}")
        
        # Step 4: Local enhancement
        print("\n[4/5] Applying local enhancement...")
        enhanced = image_processor.enhance_locally(fused)
        print("  Enhancement complete")
        
        # Step 5: Super-resolution
        print("\n[5/5] Applying super-resolution (4x)...")
        if largest_face:
            # Enhance only face region (faster)
            final = super_resolver.enhance_face(enhanced, largest_face)
        else:
            # Full image enhancement
            final = super_resolver.enhance(enhanced)
        
        print(f"  Output shape: {final.shape}")
        
        # Save results
        results_dir = "results"
        os.makedirs(results_dir, exist_ok=True)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        
        # Save individual steps
        cv2.imwrite(f"{results_dir}/{timestamp}_01_original.jpg", frames[0])
        cv2.imwrite(f"{results_dir}/{timestamp}_02_fused.jpg", fused)
        cv2.imwrite(f"{results_dir}/{timestamp}_03_enhanced.jpg", enhanced)
        cv2.imwrite(f"{results_dir}/{timestamp}_04_sr.jpg", final)
        
        print(f"\nResults saved to {results_dir}/{timestamp}_*.jpg")
        
        # Encode output
        _, output_buffer = cv2.imencode('.jpg', final, [cv2.IMWRITE_JPEG_QUALITY, 95])
        
        return send_file(
            io.BytesIO(output_buffer),
            mimetype='image/jpeg',
            as_attachment=True,
            download_name=f'sr_result_{timestamp}.jpg'
        )
        
    except Exception as e:
        print(f"Error: {e}")
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500

