import cv2
import numpy as np

class FaceDetector:
    """Face detection using OpenCV DNN"""
    
    def __init__(self, model_path: str = "models/opencv_face_detector.caffemodel",
                 config_path: str = "models/opencv_face_detector.prototxt"):
        """
        Initialize face detector
        
        Note: Download models from:
        https://github.com/opencv/opencv_3rdparty/tree/dnn_samples_face_detector_20170830
        """
        self.net = None
        self.model_path = model_path
        self.config_path = config_path
        self.confidence_threshold = 0.5
        
        try:
            self.net = cv2.dnn.readNetFromCaffe(config_path, model_path)
        except Exception as e:
            print(f"Warning: Could not load DNN model: {e}")
            print("Falling back to Haar Cascade")
            self.cascade = cv2.CascadeClassifier(
                cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
            )
    
    def detect_faces(self, image: np.ndarray, min_confidence: float = 0.5):
        """
        Detect faces in image
        
        Args:
            image: BGR image
            min_confidence: Minimum confidence threshold
            
        Returns:
            List of (x, y, w, h) tuples
        """
        faces = []
        h, w = image.shape[:2]
        
        if self.net is not None:
            blob = cv2.dnn.blobFromImage(image, 1.0, (300, 300),
                                        [104.0, 177.0, 123.0], False, False)
            self.net.setInput(blob)
            detections = self.net.forward()
            
            for i in range(detections.shape[2]):
                confidence = detections[0, 0, i, 2]
                
                if confidence > min_confidence:
                    x1 = int(detections[0, 0, i, 3] * w)
                    y1 = int(detections[0, 0, i, 4] * h)
                    x2 = int(detections[0, 0, i, 5] * w)
                    y2 = int(detections[0, 0, i, 6] * h)
                    
                    face_w = x2 - x1
                    face_h = y2 - y1
                    faces.append((x1, y1, face_w, face_h, confidence))
        else:
            # Fallback to Haar Cascade
            gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
            detected = self.cascade.detectMultiScale(gray, 1.1, 4)
            for (x, y, face_w, face_h) in detected:
                faces.append((x, y, face_w, face_h, 0.9))
        
        return faces
    
    @staticmethod
    def get_largest_face(faces):
        """Return face with largest area"""
        if not faces:
            return None
        return max(faces, key=lambda f: f[2] * f[3])
