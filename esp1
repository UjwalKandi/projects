#include <ArduinoJson.h>
#include "config.h"

// Global variables
camera_fb_t* frameBuffer[NUM_CAPTURES];
int capturedCount = 0;
bool faceDetected = false;
unsigned long lastCaptureTime = 0;

// Function prototypes
bool initCamera();
