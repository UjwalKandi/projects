### **backend/utils/super_resolver.py**
```python
import torch
import cv2
import numpy as np
from basicsr.archs.rrdbnet_arch import RRDBNet
from realesrgan import RealESRGANer

class SuperResolver:
    """Real-ESRGAN super resolution"""
    
    def __init__(self, model_path: str = "models/RealESRGAN_x4plus.pth", 
                 scale: int = 4):
        """
        Initialize super resolver
        
        Args:
            model_path: Path to RealESRGAN model
            scale: Upsampling scale (2, 3, or 4)
        """
        self.scale = scale
        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
        
        # Load model
        model = RRDBNet(num_in_ch=3, num_out_ch=3, num_feat=64, num_block=23,
                       num_grow_ch=32, scale=scale)
        
        self.upsampler = RealESRGANer(
            scale=scale,
            model_path=model_path,
            model=model,
            tile=400,
            tile_pad=10,
            pre_pad=0,
            half=torch.cuda.is_available()
        )
        
        print(f"Super-Resolver initialized on {self.device} with {scale}x scale")
    
    def enhance(self, image: np.ndarray) -> np.ndarray:
        """
        Enhance image quality
        
        Args:
            image: BGR image
            
        Returns:
            Enhanced BGR image
        """
        output, _ = self.upsampler.enhance(image, outscale=self.scale)
        return output
    
    def enhance_face(self, image: np.ndarray, face_coords: tuple = None) -> np.ndarray:
        """
        Enhance face region (more efficient)
        
        Args:
            image: BGR image
            face_coords: (x, y, w, h) or None for full image
            
        Returns:
            Enhanced image
        """
        if face_coords is None:
            return self.enhance(image)
        
        x, y, w, h = face_coords
        
        # Add padding
        pad = 20
        x_start = max(0, x - pad)
        y_start = max(0, y - pad)
        x_end = min(image.shape[1], x + w + pad)
        y_end = min(image.shape[0], y + h + pad)
        
        face_region = image[y_start:y_end, x_start:x_end]
        enhanced_face = self.enhance(face_region)
        
        # Place back (with scaling)
        scale_h = enhanced_face.shape[0] / face_region.shape[0]
        scale_w = enhanced_face.shape[1] / face_region.shape[1]
        
        output = image.copy()
        output[y_start:y_end, x_start:x_end] = enhanced_face
        
        return output
