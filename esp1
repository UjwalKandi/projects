### **backend/utils/image_processor.py**
```python
import cv2
import numpy as np
from typing import List, Tuple

class ImageProcessor:
    """Multi-image fusion and registration"""
    
    @staticmethod
    def align_images(images: List[np.ndarray]) -> List[np.ndarray]:
        """
        Align multiple images using feature matching
        
        Args:
            images: List of BGR images
            
        Returns:
            List of aligned images
        """
        if len(images) < 2:
            return images
        
        reference = images[0].copy()
        aligned = [reference]
        
        # ORB detector for edge devices
        orb = cv2.ORB_create(nfeatures=500)
        kp_ref, des_ref = orb.detectAndCompute(reference, None)
        
        if des_ref is None or len(kp_ref) < 10:
            print("Warning: Not enough features detected in reference image")
            return images
        
        for img in images[1:]:
            kp_img, des_img = orb.detectAndCompute(img, None)
            
            if des_img is None or len(kp_img) < 10:
                aligned.append(img)
                continue
            
            # Match descriptors
            bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)
            matches = bf.match(des_ref, des_img)
            matches = sorted(matches, key=lambda x: x.distance)[:20]
            
            if len(matches) < 8:
                aligned.append(img)
                continue
            
            # Compute homography
            src_pts = np.float32([kp_ref[m.queryIdx].pt for m in matches])
            dst_pts = np.float32([kp_img[m.trainIdx].pt for m in matches])
            
            H, mask = cv2.findHomography(dst_pts, src_pts, cv2.RANSAC, 5.0)
            
            if H is None:
                aligned.append(img)
                continue
            
            # Warp image
            h, w = reference.shape[:2]
            aligned_img = cv2.warpPerspective(img, H, (w, h))
            aligned.append(aligned_img)
        
        return aligned
    
    @staticmethod
    def fuse_images(images: List[np.ndarray]) -> np.ndarray:
        """
        Fuse multiple images based on sharpness weighting
        
        Args:
            images: List of aligned BGR images
            
        Returns:
            Fused image
        """
        if len(images) == 0:
            raise ValueError("No images provided")
        
        if len(images) == 1:
            return images[0]
        
        # Convert to grayscale and compute sharpness (Laplacian variance)
        sharpness_scores = []
        for img in images:
            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            laplacian = cv2.Laplacian(gray, cv2.CV_64F)
            sharpness = laplacian.var()
            sharpness_scores.append(sharpness)
        
        # Normalize weights
        sharpness_array = np.array(sharpness_scores)
        weights = sharpness_array / sharpness_array.sum()
        
        print(f"Sharpness scores: {sharpness_scores}")
        print(f"Fusion weights: {weights}")
        
        # Weighted fusion
        fused = np.zeros_like(images[0], dtype=np.float32)
        for img, weight in zip(images, weights):
            fused += img.astype(np.float32) * weight
        
        return np.uint8(np.clip(fused, 0, 255))
    
    @staticmethod
    def crop_to_face(image: np.ndarray, face_coords: Tuple) -> np.ndarray:
        """Crop image to face region"""
        x, y, w, h = face_coords
        return image[y:y+h, x:x+w]
    
    @staticmethod
    def enhance_locally(image: np.ndarray) -> np.ndarray:
        """Apply local contrast enhancement"""
        lab = cv2.cvtColor(image, cv2.COLOR_BGR2LAB)
        l, a, b = cv2.split(lab)
        
        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
        l = clahe.apply(l)
        
        enhanced = cv2.merge([l, a, b])
        return cv2.cvtColor(enhanced, cv2.COLOR_LAB2BGR)
